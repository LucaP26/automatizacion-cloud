# Copiar a .env y ajustar valores locales. .env nunca se commitea.

DATABASE_URL=postgresql+psycopg://automation_user:automation_pass@localhost:5432/automation_db
TEST_DATABASE_URL=postgresql+psycopg://automation_user:automation_pass@localhost:5432/automation_test_db

# Timeout y limites de recursos para cada ejecucion dentro del container sandbox
EXECUTION_TIMEOUT_SECONDS=30
EXECUTION_MEMORY_LIMIT=128m
EXECUTION_CPU_LIMIT=0.5

# Clave Fernet para encriptar los secretos (env vars) de cada automatizacion.
# Generar una propia por entorno, nunca reusar esta ni compartirla:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=

# Clave para firmar los JWT de autenticacion. Tiene que ser DISTINTA de
# SECRET_KEY (son dos usos criptograficos distintos). Generar una propia:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Opcional: Incoming Webhook URL (p.ej. de Slack) para avisar cuando una
# ejecucion falla. Si queda vacio, simplemente no se manda nada.
NOTIFICATION_WEBHOOK_URL=
